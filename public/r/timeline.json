{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "timeline",
  "type": "registry:component",
  "title": "Timeline",
  "author": "Carolina Lorenzo <lolalpa05@gmail.com>",
  "description": "Un componente para mostrar eventos en orden cronológico.",
  "registryDependencies": [
    "button",
    "badge"
  ],
  "dependencies": [
    "lucide-vue-next"
  ],
  "files": [
    {
      "path": "app/registry/timeline/Timeline.vue",
      "content": "<script setup lang=\"ts\">\nimport { Calendar } from 'lucide-vue-next'\nimport { Badge } from '@/components/ui/badge'\nimport { Button } from '@/components/ui/button'\n\nexport interface TimelineItem {\n  date: string\n  title: string\n  description: string\n  badge?: string\n  link?: {\n    text: string\n    url: string\n  }\n}\n\nconst { items = [] } = defineProps<{\n  items?: TimelineItem[]\n}>()\n</script>\n\n<template>\n  <ol class=\"relative border-s border-border\">\n    <li\n      v-for=\"(item, index) in items\"\n      :key=\"index\"\n      class=\"ms-6\"\n      :class=\"[index !== items.length - 1 && 'mb-10']\"\n    >\n      <span class=\"absolute flex items-center justify-center w-6 h-6 bg-accent rounded-full -start-3 ring-8 ring-background\">\n        <Calendar class=\"w-3 h-3 text-accent-foreground\" />\n      </span>\n      \n      <time class=\"bg-secondary border border-border text-foreground text-xs font-medium px-1.5 py-0.5 rounded\">\n        {{ item.date }}\n      </time>\n      \n      <h3 class=\"flex items-center mb-1 text-lg font-semibold text-foreground my-2\">\n        {{ item.title }}\n        <Badge v-if=\"item.badge\" class=\"ms-2\" variant=\"secondary\">\n          {{ item.badge }}\n        </Badge>\n      </h3>\n      \n      <p class=\"mb-4 text-muted-foreground\">\n        {{ item.description }}\n      </p>\n      \n      <Button\n        v-if=\"item.link\"\n        variant=\"outline\"\n        size=\"sm\"\n        as-child\n      >\n        <a :href=\"item.link.url\">\n          {{ item.link.text }}\n        </a>\n      </Button>\n    </li>\n  </ol>\n</template>\n",
      "type": "registry:ui"
    }
  ]
}
